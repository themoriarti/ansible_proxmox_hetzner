#!/bin/bash
# Proxmox health check script
# Generated by Ansible - {{ ansible_managed }}

LOG_FILE="/var/log/proxmox-health.log"
DATE=$(date '+%Y-%m-%d %H:%M:%S')

# Function to log messages
log_message() {
    echo "[$DATE] $1" >> $LOG_FILE
}

# Check Proxmox services
check_services() {
    local services=("pve-cluster" "pve-daemon" "pveproxy" "pvedaemon" "pvestatd")
    local failed_services=()
    
    for service in "${services[@]}"; do
        if ! systemctl is-active --quiet $service; then
            failed_services+=($service)
        fi
    done
    
    if [ ${#failed_services[@]} -gt 0 ]; then
        log_message "WARNING: Failed services: ${failed_services[*]}"
        return 1
    else
        log_message "INFO: All Proxmox services are running"
        return 0
    fi
}

# Check disk space
check_disk_space() {
    local threshold=85
    local usage=$(df / | awk 'NR==2 {print $5}' | sed 's/%//')
    
    if [ $usage -gt $threshold ]; then
        log_message "WARNING: Disk usage is ${usage}% (threshold: ${threshold}%)"
        return 1
    else
        log_message "INFO: Disk usage is ${usage}%"
        return 0
    fi
}

# Check memory usage
check_memory() {
    local threshold=90
    local usage=$(free | awk 'NR==2{printf "%.0f", $3*100/$2}')
    
    if [ $usage -gt $threshold ]; then
        log_message "WARNING: Memory usage is ${usage}% (threshold: ${threshold}%)"
        return 1
    else
        log_message "INFO: Memory usage is ${usage}%"
        return 0
    fi
}

# Check ZFS pools
check_zfs() {
    if command -v zpool &> /dev/null; then
        local pools=$(zpool list -H -o name)
        for pool in $pools; do
            local status=$(zpool status $pool | grep -c "ONLINE")
            if [ $status -eq 0 ]; then
                log_message "WARNING: ZFS pool $pool is not healthy"
                return 1
            fi
        done
        log_message "INFO: All ZFS pools are healthy"
    fi
    return 0
}

# Check network connectivity
check_network() {
    if ! ping -c 1 8.8.8.8 &> /dev/null; then
        log_message "WARNING: No internet connectivity"
        return 1
    else
        log_message "INFO: Network connectivity OK"
        return 0
    fi
}

# Main health check
main() {
    log_message "Starting Proxmox health check"
    
    local exit_code=0
    
    check_services || exit_code=1
    check_disk_space || exit_code=1
    check_memory || exit_code=1
    check_zfs || exit_code=1
    check_network || exit_code=1
    
    if [ $exit_code -eq 0 ]; then
        log_message "Health check completed successfully"
    else
        log_message "Health check completed with warnings"
    fi
    
    exit $exit_code
}

# Run main function
main "$@"
