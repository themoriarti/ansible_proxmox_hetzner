# DNSMasq configuration for VM network
# Generated by Ansible - {{ ansible_managed }}

# Interface to bind to
interface={{ proxmox_network.vm_bridge_name }}

# DHCP range
dhcp-range={{ proxmox_network.vm_network_vm_lan_dhcp_from }},{{ proxmox_network.vm_network_vm_lan_dhcp_to }},12h

# Gateway
dhcp-option=3,{{ proxmox_network.vm_network_vm_lan_ip }}

# DNS servers
dhcp-option=6,8.8.8.8,8.8.4.4

# Domain
domain={{ ansible_facts.domain | default('local') }}

# Don't read /etc/hosts
no-hosts

# Don't read /etc/resolv.conf
no-resolv

# Use specific DNS servers
server=8.8.8.8
server=8.8.4.4

# Log DHCP requests
log-dhcp

# Enable DHCP
dhcp-authoritative
