# Hetzner installimage configuration
# Generated by Ansible - {{ ansible_managed }}

# Basic system settings
DRIVE1 /dev/{{ disk_config.boot_disk }}
SWRAID 1
SWRAIDLEVEL 1
BOOTLOADER grub
HOSTNAME {{ inventory_hostname }}
PART /boot ext4 512M
PART lvm vg0 all

# LVM configuration
LV vg0 root / ext4 20G
LV vg0 swap swap swap 4G
LV vg0 var /var ext4 10G
LV vg0 tmp /tmp ext4 2G
LV vg0 home /home ext4 5G

# Network configuration
{% if ansible_facts.default_ipv4 is defined %}
IPADDR {{ ansible_facts.default_ipv4.address }}
NETMASK {{ ansible_facts.default_ipv4.netmask }}
GATEWAY {{ ansible_facts.default_ipv4.gateway }}
{% endif %}

# DNS configuration
NAMESERVER 8.8.8.8
NAMESERVER 8.8.4.4

# Additional drives for ZFS
{% for disk in disk_config.data_disks %}
DRIVE{{ loop.index + 1 }} /dev/{{ disk }}
{% endfor %}

# ZFS configuration
{% if proxmox_storage.enable_zfs | default(true) %}
ZFS_POOL {{ proxmox_storage.zfs_pool_name | default('rpool') }}
ZFS_RAID_LEVEL {{ zfs_pool_config.raid_level | default('mirror') }}
{% endif %}

# Security settings
{% if luks_password is defined %}
LUKS_PASSWORD {{ luks_password }}
{% endif %}

# SSH keys
{% for key in proxmox_ssh_keys | default([]) %}
SSHKEY {{ key }}
{% endfor %}

# Additional packages
PACKAGES "zfsutils-linux bridge-utils libguestfs-tools htop iotop tcpdump git nano screen"
