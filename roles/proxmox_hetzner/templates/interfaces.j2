# Network interfaces configuration
# Generated by Ansible - {{ ansible_managed }}

# Loopback interface
auto lo
iface lo inet loopback

# Main network interface
auto {{ ansible_facts.default_ipv4.interface }}
iface {{ ansible_facts.default_ipv4.interface }} inet static
    address {{ ansible_facts.default_ipv4.address }}
    netmask {{ ansible_facts.default_ipv4.netmask }}
    gateway {{ ansible_facts.default_ipv4.gateway }}
    dns-nameservers 8.8.8.8 8.8.4.4

# VM bridge interface
auto {{ proxmox_network.vm_bridge_name }}
iface {{ proxmox_network.vm_bridge_name }} inet static
    address {{ proxmox_network.vm_network_lan_ip }}/{{ proxmox_network.vm_network_lan_subnet }}
    bridge_ports none
    bridge_stp off
    bridge_fd 0
    bridge_maxwait 0
    post-up echo 1 > /proc/sys/net/ipv4/ip_forward
    post-up iptables -t nat -A POSTROUTING -s {{ proxmox_network.vm_network_lan_ip }}/{{ proxmox_network.vm_network_lan_subnet }} -o {{ ansible_facts.default_ipv4.interface }} -j MASQUERADE
    post-down iptables -t nat -D POSTROUTING -s {{ proxmox_network.vm_network_lan_ip }}/{{ proxmox_network.vm_network_lan_subnet }} -o {{ ansible_facts.default_ipv4.interface }} -j MASQUERADE
